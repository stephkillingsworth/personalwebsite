---
import WrapButton from "../../layouts/WrapButton.astro";
import DownloadButton from "../buttons/DownloadButton.astro";
import SendMessageButton from "../buttons/SendMessageButton.astro";
import Authors from "./Authors.astro";

interface JournalArticle {
  id: string;
  authors: string[];
  year: string;
  title: string;
  journal: string;
  pageVol: string;
  doi?: string;
  pdfUrl?: string;
  altUrl?: string;
  altmetricImg?: string;
  isRequest: boolean;
  marker?: string;
  number?: string;
}

const {
  id,
  authors,
  year,
  title,
  journal,
  pageVol,
  doi,
  altUrl,
  pdfUrl,
  altmetricImg,
  isRequest,
  marker,
  number
} = Astro.props as JournalArticle;
---

<div class={`my-2 ${id}`}>
  <div class="flex items-center gap-3">
    {altmetricImg && (
      <img src={altmetricImg} alt="Altmetric score" class="w-16 h-16" />
    )}
    <p class="text-chetwode-950 dark:text-chetwode-50">
      {number && <span class="font-bold">{number}</span>} <Authors authors={authors} /> {title}. <em>{journal}</em>{pageVol && `, ${pageVol}` ? `, ${pageVol}` : ""}. <span class="text-porsche-400 font-bold">{marker}</span>
    </p>
  </div>

  {
    (doi || altUrl) && (
      <WrapButton>
        <DownloadButton text="View Article" url={doi ? doi : altUrl} />
        {pdfUrl && isRequest ? (
          <SendMessageButton
            text="Request PDF"
            url={pdfUrl}
            extendClass="btn-active"
          />
        ) : (
          pdfUrl && (
            <DownloadButton
              text="Download PDF"
              url={pdfUrl}
              isDownload="true"
              extendClass="btn-active"
            />
          )
        )}
      </WrapButton>
    )
  }
</div>