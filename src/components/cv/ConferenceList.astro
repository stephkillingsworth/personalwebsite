<div class="mx-auto h-full max-w-5xl py-6 sm:py-16 lg:py-8">
  <Background backgroundImage={teachingIcon} />
  <PageTitle title="Conferences & Speaking Engagements" />
  <CardLayout>
  {
  conferences.map((conf, index) => (
    <Card
      isLast={index === conferences.length - 1}
    >
      <p class={cardDescriptionClasses}>
        <span class="font-bold">{conf.num}. </span>
        <strong>{conf.citation}</strong>{conf.rest}
        {conf.role && (
          <span class="block font-serif text-lg text-porsche-800 mt-1">
            {conf.role}
          </span>
        )}
      </p>
    </Card>
  ))
}
  </CardLayout>
</div>