---
import Layout from "../layouts/Layout.astro";
import PageTitle from "../components/PageTitle.astro";
import researchIcon from "../assets/icons/research.svg";
import Background from "../components/Background.astro";
import MainPage from "../components/MainPage.astro";
import PageDescription from "../components/PageDescription.astro";
import cntl from "cntl";
import FossilHorses from "../components/research/FossilHorses.astro";
import Geochemistry from "../components/research/Geochemistry.astro";
import AiComputing from "../components/research/AiComputing.astro";
import Education from "../components/research/Education.astro";

const tabData = [
  { id: "fossil-horses", label: "Fossil Horses" },
  { id: "geochemistry", label: "Geochemistry" },
  { id: "ai-computing", label: "AI & Computing" },
  { id: "education", label: "Education" },
];

const tabContainerClasses = cntl`
  border
  border-chetwode-200
  dark:border-chetwode-900
  flex
  rounded-full
  items-center
  justify-center
  w-fit
  mx-auto
  mt-8
  gap-x-2
  overflow-x-auto
  scrollbar-hide
`;

const activeClass = cntl`
  bg-chetwode-600
  dark:bg-chetwode-300
  text-white
  dark:text-porsche-950
  font-semibold
`;

const inactiveClass = cntl`
  border-r
  pr-4
  border-chetwode-200
  dark:border-chetwode-900
  text-porsche-950
  dark:text-porsche-50
  hover:bg-chetwode-300
  dark:hover:bg-chetwode-800
  font-normal
`;
---

<Layout title="Research Projects">
  <MainPage>
    <Background backgroundImage={researchIcon} />
    <PageTitle title="Research Projects">
      <PageDescription>
        I am a vertebrate paleontologist and Ph.D. candidate at the University
        of Florida whose research integrates museum collections, morphology,
        paleobiology, and evolutionary history to investigate patterns of
        mammalian diversity and adaptation through the Cenozoic. My work focuses
        on fossil mammals and the use of quantitative approaches, including
        geometric morphometrics, Bayesian phylogenetics, and AI to address
        questions in evolution, ecology, and functional morphology. In parallel,
        I develop and coordinate programs that connect scientists, educators,
        students, and communities through authentic STEM experiences — expanding
        access to Earth and environmental sciences across Florida.
      </PageDescription>
    </PageTitle>
    <div class={tabContainerClasses}>
      {
        tabData.map((tab) => (
          <button
            class={`tab-button px-4 py-2 rounded-full transition-colors duration-300 ${inactiveClass} ${tab.id === "fossil-horses" ? activeClass : ""}`}
            data-section={tab.id}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    <div id="fossil-horses-section" class="mt-8">
      <FossilHorses />
    </div>
    <div id="geochemistry-section" class="mt-8 hidden">
      <Geochemistry />
    </div>
    <div id="ai-computing-section" class="mt-8 hidden">
      <AiComputing />
    </div>
    <div id="education-section" class="mt-8 hidden">
      <Education />
    </div>
  </MainPage>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      function showSection(section: string) {
        const sections = ["fossil-horses", "geochemistry", "ai-computing", "education"];
        sections.forEach((sec) => {
          const element = document.querySelector(`#${sec}-section`);
          if (element) element.classList.add("hidden");
        });
        const activeSection = document.querySelector(`#${section}-section`);
        if (activeSection) activeSection.classList.remove("hidden");

        document.querySelectorAll(".tab-button").forEach((btn) => {
          btn.classList.remove("bg-chetwode-600", "dark:bg-chetwode-300", "text-white", "dark:text-porsche-950", "font-semibold");
          btn.classList.add("text-porsche-950", "dark:text-porsche-50", "hover:bg-chetwode-300", "dark:hover:bg-chetwode-800", "font-normal");
        });

        const activeButton = document.querySelector(`[data-section="${section}"]`);
        if (activeButton) {
          activeButton.classList.remove("text-chetwode-950", "dark:text-porsche-50", "hover:bg-chetwode-300", "dark:hover:bg-chetwode-800", "font-normal");
          activeButton.classList.add("bg-chetwode-600", "dark:bg-chetwode-300", "text-white", "dark:text-porsche-950", "font-semibold");
        }
      }

      const buttons = document.querySelectorAll(".tab-button");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const section = button.getAttribute("data-section");
          if (section) showSection(section);
        });
      });
    });
  </script>
</Layout>
