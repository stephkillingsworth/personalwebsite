---
import Layout from "../layouts/Layout.astro";
import profilePhoto from "../assets/img/profile.webp";
import Stats from "../components/Stats.astro";
import rodentSvg from "../assets/icons/mammals.svg";
import Background from "../components/Background.astro";
import cntl from "cntl";
import MainPage from "../components/MainPage.astro";
import PageDescription from "../components/PageDescription.astro";
import Image from "astro/components/Image.astro";
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
// import handikaResearch from "../assets/img/handika-research.webp";

const titleClasses = cntl`
  font-serif
  text-5xl
  text-chetwode-950
  dark:text-chetwode-50
  mt-2
`;

const heroTextClasses = cntl`
  mt-4
  text-pretty
  text-lg
  text-slate-700
  dark:text-slate-200
  sm:text-xl/8
`;

const researchSentenceClasses = cntl`
  font-serif
  font-semibold
  text-3xl
  bg-gradient-to-r
  from-porsche-600
  to-chetwode-700
  dark:from-porsche-300
  dark:to-chetwode-200
  bg-clip-text
  text-transparent
`;

const sectionTitleClasses = cntl`
  text-2xl
  text-porsche-950
  dark:text-porsche-50
  text-center
  m-4
`;

const statsGridClasses = cntl`
  grid
  bg-gradient-to-r
  from-porsche-400
  to-chetwode-200
  dark:from-porsche-700
  dark:to-chetwode-600
  lg:grid-cols-3
  gap-4
  text-center
  rounded-2xl
  lg:rounded-full
  mt-16
  mx-8
  lg:mx-24
  animate-slide-in-bottom
`;

const keywordClasses = cntl`
    border-2
    border-chetwode-300
    dark:border-chetwode-400
    text-chetwode-700
    dark:text-chetwode-400
    rounded-full
    py-1
    px-4 
    text-sm
    font-semibold 
`;

const keywordList = [
  "Cenozoic Mammals",
  "Museum Collections",
  "Artificial Intelligence",
];

const highlightedTextClasses = cntl`
  bg-porsche-100
  dark:bg-porsche-700
  text-porsche-800
  dark:text-porsche-50
  px-2
  pb-1
  inline-block
  -rotate-3
`;

const highlightedTextClasses2 = cntl`
  bg-chetwode-100
  dark:bg-chetwode-700
  text-chetwode-800
  dark:text-chetwode-50
  px-2
  pb-1
  inline-block
  rotate-2
`;

const buttonClasses = cntl`
  mt-12
  mx-auto
  bg-chetwode-600
  hover:bg-chetwode-900
  text-chetwode-50
  font-semibold
  py-3
  px-6
  rounded-xl
  shadow-lg
  transition
  duration-300
  ease-in-out
  w-fit
`;
---

<Layout
  title="Cenozoic mammalian evolution, museum collections, and quantitative paleobiology"
>
  <MainPage>
    <Background backgroundImage={rodentSvg} />
    <div class="text-center item-center mt-8 md:mt-16">
      <Image
        class="block mx-auto rounded-full sm:mx-auto"
        src={profilePhoto}
        height={180}
        width={180}
        loading="lazy"
        alt="Handika's profile"
      />
      <h1 class={titleClasses}>
        Hi, I'm <strong>Stephanie R. Killingsworth</strong>
      </h1>
      <PageDescription>
        Ph.D. Candidate · Vertebrate Paleontology · Department of Geological Sciences · University of Florida, USA
      </PageDescription>
      <div
        class="flex flex-wrap justify-center gap-x-2 gap-y-2 sm:gap-x-4 px-2 mt-2"
      >
        {
          keywordList.map((keyword) => (
            <div class={keywordClasses}>
              <p class="text-center">{keyword}</p>
            </div>
          ))
        }
      </div>
      <p class={heroTextClasses}>
        I am a vertebrate paleontologist and Ph.D. candidate at the University of Florida and Florida Museum of Natural History. My research integrates museum collections, morphology, paleobiology, and evolutionary history to examine the drivers of mammalian diversity and adaptation across the Cenozoic. Using fossil mammals as a model system, I apply quantitative methods, including geometric morphometrics, Bayesian phylogenetics, and artificial intelligence, to investigate evolutionary and paleoecological processes. Beyond research, I lead broader impacts initiatives that connect scientists, museums, K-12 educators, and communities through professional development, outreach, and authentic STEM experiences that foster engagement with science and emerging AI-enabled careers.
      </p>
    </div>
    <SocialMediaIcons />
    <div class="flex justify-center mt-4">
      <a
        href="mailto:skillingsworth@floridamuseum.ufl.edu"
        class="py-2 px-6 text-sm rounded-full border border-chetwode-200 dark:border-chetwode-900 text-porsche-950 dark:text-porsche-50 hover:bg-chetwode-300 dark:hover:bg-chetwode-800 transition-colors duration-300"
      >
        ✉ Contact Me
      </a>
    </div>    
    <div class={statsGridClasses}>
  <Stats
    title="Research"
    value="Neogene"
    unit="fossil horses"
    url="/projects"
  />

  <Stats
    title="Collections"
    value="Museum"
    unit="specimen-based research"
    url="/fieldwork"
  />

  <Stats
    title="Outreach"
    value="K-12"
    unit="teacher & scientist partnerships"
    url="/cv"
  />
</div>

<div id="key-approach" class="mt-16 mx-auto text-center text-pretty">
  <p class="text-porsche-950 dark:text-porsche-50 text-lg">
    Research Focus:
  </p>

  <p class={researchSentenceClasses}>
    "Investigating the evolutionary history of Cenozoic mammals through museum
    collections, geometric morphometrics, artificial intelligence, and
    phylogenetic approaches."
  </p>
</div>
    <!-- <div class="text-left">
        <h2 class="mb-2 text-xl text-porsche-950 dark:text-porsche-50">
          It's code- and field-intensive research, involving many collaborators
          and local communities.
        </h2>
      </div>
    </div>
    <div class="mt-16">
      <h2
        class="mb-4 font-semibold text-center text-2xl text-chetwode-950 dark:text-chetwode-50"
      >
        30+ expeditions and counting...
      </h2>
      <p></p>
    </div> -->
    <div class="mt-16">
      <h2
        class="mb-4 font-semibold text-center text-2xl text-chetwode-950 dark:text-chetwode-50"
      >
        Research Questions
      </h2>
    <h3 class={sectionTitleClasses}>
  How can we quantify
  <span class={highlightedTextClasses}> microevoltionary transitions</span>
  within
  <span class={highlightedTextClasses2}>paleopopulations</span>?
</h3>

<div class={sectionTitleClasses}>
  <h3>
    How can
    <span class={highlightedTextClasses}>museum collections</span>,
    geometric morphometrics, and
    <span class={highlightedTextClasses2}>artificial intelligence</span>
    be integrated to study patterns in the fossil record?
  </h3>
</div>

<div class={sectionTitleClasses}>
  <h3>
    How can scientific research be translated into meaningful
    <span class={highlightedTextClasses}>educational experiences</span>
    and broader
    <span class={highlightedTextClasses2}>public engagement</span>
    opportunities?
  </h3>
</div>
    <div class={buttonClasses}>
      <a href="/projects">
        <p>Learn more</p>
      </a>
    </div>
  </MainPage></Layout
>
