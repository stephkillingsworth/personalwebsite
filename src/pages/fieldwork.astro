---
import PageTitle from "../components/PageTitle.astro";
import Layout from "../layouts/Layout.astro";
import fieldIcon from "../assets/icons/fieldwork.svg";
import Background from "../components/Background.astro";
import MainPage from "../components/MainPage.astro";
import PageDescription from "../components/PageDescription.astro";

// Fieldwork images
import imgCalifornia      from "../assets/img/california.jpg";
import imgCanoe           from "../assets/img/canoe.jpg";
import imgFlorida         from "../assets/img/Florida.jpg";
import imgHorsetooth      from "../assets/img/horsetoothinsitu.jpg";
import imgMeinnm          from "../assets/img/meinnm.jpg";
import imgMeinnm2         from "../assets/img/meinnm2.jpg";
import imgNebraska        from "../assets/img/nebraska.jpg";
import imgNewmexico       from "../assets/img/newmexico.jpg";
import imgPanama          from "../assets/img/panama.jpg";
import imgThehike         from "../assets/img/thehike.jpg";
// Museum collections images
import imgUcmp            from "../assets/img/ucmp.jpg";
import imgMicrofossils    from "../assets/img/microfossils.jpg";
import imgMeincar         from "../assets/img/meincar.jpg";
import imgCabinet         from "../assets/img/cabinet.jpg";
import imgAmnh            from "../assets/img/amnh.jpg";
import imgUsnm            from "../assets/img/usnm.jpg";
// Lab images
import imgMeinlab         from "../assets/img/meinlab.jpg";
import imgMicroct         from "../assets/img/microct.jpg";
import imgREEs            from "../assets/img/REEs.jpg";
import imgIcpms           from "../assets/img/ICPMS.jpg";
import imgLabvisit        from "../assets/img/labvisit.jpg";
import imgGeochemistry    from "../assets/img/geochemistry.jpg";
---

<Layout title="Field, Museum Collections, & Lab Work">
  <MainPage>
    <Background backgroundImage={fieldIcon} />
    <PageTitle title="Field, Museum Collections, & Lab Work">
      <PageDescription>
        Museum collections research has taken me to the Florida Museum of 
        Natural History, the American Museum of Natural History, the Smithsonian 
        National Museum of Natural History, the Natural History Museum of Los 
        Angeles County, the UC Museum of Paleontology, and the Panhandle-Plains 
        Historical Museum, where I have studied fossil horses, sharks, and 
        other mammal specimens central to my dissertation and M.S. thesis 
        research. In the lab, my geochemical work includes column chemistry, 
        ICP-MS, rare earth element (REE) analysis, strontium isotope analysis, 
        and micro-CT scanning.

      </PageDescription>
    </PageTitle>

    <!-- ── SECTION NAV ────────────────────────────────────────────── -->
    <nav class="section-nav">
      <a href="#fieldwork">Fieldwork</a>
      <span class="divider">·</span>
      <a href="#collections">Museum Collections</a>
      <span class="divider">·</span>
      <a href="#lab">Lab &amp; Geochemistry</a>
    </nav>

    <!-- ══════════════════════════════════════════════════════════════
         SECTION 1 — FIELDWORK
    ══════════════════════════════════════════════════════════════ -->
    <section id="fieldwork" class="work-section">
      <h2 class="section-heading">Fieldwork</h2>

      <div class="region-block">
        <h3 class="region-label">North America &amp; Panama</h3>
        <div class="photo-grid">
          <figure class="photo-item photo-wide">
            <img src={imgFlorida.src}    alt="Fieldwork in Florida" />
            <figcaption>Florida creek collecting</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgNebraska.src}   alt="Fieldwork in Nebraska" />
            <figcaption>The Badlands of Nebraska</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgNewmexico.src}  alt="Fieldwork in New Mexico" />
            <figcaption>Exposing specimen in New Mexico</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgMeinnm.src}     alt="At the New Mexico site" />
            <figcaption>New Mexico site</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgMeinnm2.src}    alt="New Mexico fieldwork" />
            <figcaption>New Mexico fieldwork</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgThehike.src}    alt="The hike to field site" />
            <figcaption>Hike to field site</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgHorsetooth.src} alt="Horse tooth in situ" />
            <figcaption>Horse tooth in situ</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgCalifornia.src} alt="Fieldwork in California" />
            <figcaption>Santa Cruz, California</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgPanama.src}     alt="Fieldwork in Panama" />
            <figcaption>Panama</figcaption>
          </figure>
          <figure class="photo-item">
            <img src={imgCanoe.src}      alt="Canoe fieldwork" />
            <figcaption>Panama collecting via canoe</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         SECTION 2 — MUSEUM COLLECTIONS
    ══════════════════════════════════════════════════════════════ -->
    <section id="collections" class="work-section">
      <h2 class="section-heading">Museum Collections</h2>
      <p class="section-intro">
        Visiting natural history collections is an essential part of
        comparative vertebrate research. These visits allow direct measurement
        and study of type specimens, rare taxa, and historical series that are
        not otherwise accessible.
      </p>
      <div class="photo-grid">
        <figure class="photo-item photo-wide">
          <img src={imgUcmp.src} alt="UC Museum of Paleontology" />
          <figcaption>University of California Museum of Paleontology (UCMP), Berkeley</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgMicrofossils.src} alt="Microfossil specimens" />
          <figcaption>Screenwashing</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgMeincar.src} alt="Traveling to collections" />
          <figcaption>En route to collections visit</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgCabinet.src} alt="Museum specimen cabinet" />
          <figcaption>Specimen cabinet</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgAmnh.src} alt="American Museum of Natural History" />
          <figcaption>AMNH, New York</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgUsnm.src} alt="Smithsonian National Museum of Natural History" />
          <figcaption>USNM, Washington D.C.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         SECTION 3 — LAB & GEOCHEMISTRY
    ══════════════════════════════════════════════════════════════ -->
    <section id="lab" class="work-section">
      <h2 class="section-heading">Lab &amp; Geochemistry</h2>
      <p class="section-intro">
        Laboratory work bridges field collections and published findings.
        Geochemical analyses, including isotope work and elemental 
        characterization, provide independent lines of evidence for
        reconstructing environments, diets, and biogeographic histories.
      </p>
      <div class="photo-grid">
        <figure class="photo-item photo-wide">
          <img src={imgMeinlab.src} alt="In the lab" />
          <figcaption>Lab work</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgMicroct.src} alt="MicroCT scanning" />
          <figcaption>MicroCT scanning</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgREEs.src} alt="Rare earth element analysis" />
          <figcaption>REE analysis</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgIcpms.src} alt="ICP-MS instrument" />
          <figcaption>ICP-MS</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgLabvisit.src} alt="Lab visit" />
          <figcaption>Showcasing lab work to K-12 classroom</figcaption>
        </figure>
        <figure class="photo-item">
          <img src={imgGeochemistry.src} alt="Geochemistry work" />
          <figcaption>K-12 visit on geochemistry</figcaption>
        </figure>
      </div>
    </section>

  </MainPage>
</Layout>

<!-- ── STYLES ─────────────────────────────────────────────────────── -->
<style>
  /* ── tokens ── */
  :root {
    --gold:       #C9A465;
    --gold-light: #E2C08A;
    --ink:        #E8DCC8;
    --muted:      #A89880;
    --rule:       #3A3020;
    --gap:        clamp(1.5rem, 4vw, 3rem);
    --photo-size: 260px;
    --photo-tall: 320px;
  }

  /* ── section nav ── */
  .section-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 1rem 0 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--gap);
    font-size: 0.875rem;
    letter-spacing: 0.01em;
  }
  .section-nav a {
    color: var(--gold);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s;
  }
  .section-nav a:hover { color: var(--gold-light); }
  .section-nav .divider { color: var(--rule); }

  /* ── sections ── */
  .work-section {
    margin-bottom: calc(var(--gap) * 2.5);
    scroll-margin-top: 5rem;
  }

  .section-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    border-left: 4px solid var(--gold);
    padding-left: 0.75rem;
    margin-bottom: 1.5rem;
    line-height: 1.2;
    color: var(--gold);
  }

  .section-intro {
    max-width: 65ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  /* ── region blocks ── */
  .region-block {
    margin-bottom: calc(var(--gap) * 1.5);
  }

  .region-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  /* ── photo grid ──
     flex instead of grid so the last row centers naturally
     rather than leaving ragged left-aligned gaps.
  ── */
  .photo-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .photo-item {
    margin: 0;
    overflow: hidden;
    width: var(--photo-size);
    flex-shrink: 0;
  }

  .photo-item img {
    width: 100%;
    height: var(--photo-size);
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .photo-item:hover img {
    transform: scale(1.03);
  }

  .photo-item figcaption {
    font-size: 0.875rem;
    color: var(--muted);
    padding: 0.35rem 0.5rem 0.4rem;
    letter-spacing: 0.02em;
  }

  /* wider item for hero shots — spans roughly 2 columns */
  .photo-wide {
    width: calc(var(--photo-size) * 2 + 0.85rem);
  }
  .photo-wide img {
    height: var(--photo-tall);
  }

  /* ── timeline ── */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--gold);
    padding-left: 1.25rem;
  }

  .tl-item {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.5rem 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .tl-item:last-child { border-bottom: none; }

  .tl-date {
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
    padding-top: 0.1rem;
  }

  .tl-body {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6rem;
    align-items: baseline;
  }

  .tl-body strong {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  .tl-sub {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ── responsive ── */
  @media (max-width: 640px) {
    :root {
      --photo-size: 160px;
      --photo-tall: 200px;
    }
    .photo-wide {
      width: 100%;
    }
    .tl-item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .tl-date { font-size: 0.875rem; }
    .section-nav { gap: 0.4rem 0.75rem; }
  }
</style>
